/*** ^^A -*-C++-*- **********************************************/
/*	autot1			22.11.1995			*/
/****************************************************************/
/*	Short Description :					*/
/*	AU program for automatic processing of a 2D T1/T2	*/
/*	experiment with subsequent T1/T2 calculation.		*/
/****************************************************************/
/*	Keywords :						*/
/*	T1/T2, T1 and T2					*/
/****************************************************************/
/*	Description/Usage :					*/
/*	AU program for automatic processing of a 2D T1/T2	*/
/*	experiment with subsequent T1/T2 calculation.This AU	*/
/*	program is particularly useful in cases where you	*/
/*	want to fit the data fully automatically. The baslpnts	*/
/*	and intrng file are created with the "ppt1" command.	*/
/*	The peak picking region is determined by the values of	*/
/*	ABSF1 and ABSF2 which are also used for the baseline	*/
/*	correction of the 2D experiment.			*/
/*								*/
/*	works as follows :					*/
/*								*/
/*	1. Switch to the T1/T2 experiment.			*/
/*	2. Read the last fid of the T1/T2 experiment. This fid	*/
/*	   supposedly contains the equilibrium data (all	*/
/*	   signals positive). This fid is processed with "efp",	*/
/*	   automatically phased ("apk"),and baseline corrected	*/
/*	   ("abs").						*/
/*	3. Run "ppt1" to generate baslpnts and intrng file.	*/
/*	   Memorize the phase angles and transfer them to	*/
/*	   the T1/T2 experiment. Also copy the baslpnts and	*/
/*	   and intrng file to the 2D data set.			*/
/*	4. Do xf2 with phase correction and then automatic	*/
/*	   baseline correction.					*/
/*	5. Do T1 or T2 fit as requested. The number of time	*/
/*	   points for the T1/T2 calculation is set to the	*/
/*	   number of experiments (TD in F1) of the serial file	*/
/*	   The results are written to the file "ct1t2.txt"	*/
/*	The program is called by "xau autot1 1" for T1 or	*/
/*	"xau autot1 2" for T2 calculations. Alternatively,	*/
/*	type "autot1" and the program will ask which type of	*/
/*	calculation it needs to do. There is no other user	*/
/*	interaction apart from this question			*/
/****************************************************************/
/*	Author(s) :						*/
/*	Name		: Joost A. B. Lohman			*/
/*	Organisation	: Bruker Spectrospin ltd.		*/
/*	Name		: Mike Engelhardt			*/
/*	Organisation	: Bruker BioSpin GmbH			*/
/*	Email		: michael.engelhardt@bruker.de		*/
/****************************************************************/
/*	Name		Date	Modification:			*/
/*	jab		951122	created				*/
/*	eng		980415	revised				*/
/*	eng		090415	CURPRIN handling removed	*/
/****************************************************************/
/*
$Id:$
*/

char	inttarget[PATH_MAX], basltarget[PATH_MAX], cmdtxt[64];
int	ret, pparmod, lastpoint;
float	sr, absf1, absf2, phc0, phc1;
double	leftend, leftlimit, rightlimit, offset, sweepwidth, larmorfreq;
int	tmp_procno;
int	cur_procno = procno;
int	t1_t2_mode = 1;

FETCHPARS("PPARMOD", &pparmod)
if (pparmod != 1)
  STOPMSG("Program is only suitable for 2D data!")

/* determine which type of calculation needs to be done
   look on the command line first */

if (i_argc > 2)
{
  t1_t2_mode = atoi(i_argv[2]);
  if (t1_t2_mode != 1  &&  t1_t2_mode != 2)
    STOPMSG("argument must be either 1 or 2")
}
else
  GETINT("T1 (1) or T2 (2) calculation ?", t1_t2_mode)

/* get some relevant parameters	*/

FETCHPARS( "O1", &offset )
FETCHPARS( "SR", &sr )
FETCHPARS( "SW", &sweepwidth )
FETCHPARS( "BF1", &larmorfreq )
FETCHPAR( "ABSF1", &absf1 )
FETCHPAR( "ABSF2", &absf2 )
FETCHPAR1S( "TD", &lastpoint )

/* calculate ppm value of left end of spectrum */

leftend = (offset - sr) / larmorfreq + sweepwidth / 2.0;

/* make sure the peak picking region is within the spectral width */

leftlimit  = absf1;
rightlimit = absf2;

if (leftlimit > leftend)
  leftlimit = leftend;
if (rightlimit < leftend - sweepwidth)
  rightlimit = leftend - sweepwidth;

strcpy(inttarget, PROCPATH("intrng"));
strcpy(basltarget,PROCPATH("baslpnts"));

/* search first free PROCNO */
do
  procno++;
while (access(PROCPATH(0), F_OK) == 0);

tmp_procno = procno;
procno = cur_procno;

/* switch to last fid, process with ef, apk and abs;
   get phase correction values for later use */

sprintf(cmdtxt, "ef %d %d n", lastpoint, tmp_procno);
XCMD(cmdtxt)
ERRORABORT

DATASET(name, expno, tmp_procno, disk, user)
APK
ERRORABORT
ABSF
FETCHPAR( "PHC0", &phc0 )
FETCHPAR( "PHC1", &phc1 )

/* create baslpnts and intrng file with ppt1 */

STOREPAR( "F1P", leftlimit )
STOREPAR( "F2P", rightlimit )
XCMD("ppt1")
ERRORABORT

/* copy baslpnts and intrng file to 2D T1/T2 experiment */
if ((ret = dircp(PROCPATH("intrng"),inttarget)) < 0)
  STOPMSG(dircp_err(ret))

if ((ret = dircp(PROCPATH("baslpnts"),basltarget)) < 0)
  STOPMSG(dircp_err(ret))

/* switch back to 2D T1/T2 experiment, set phasing parameters
   and transform */

DATASET(name, expno, cur_procno, disk, user)
DELETEPROCNO(name, expno, tmp_procno, disk, user)
STOREPAR( "PHC0", phc0 )
STOREPAR( "PHC1", phc1 )
XF2
ERRORABORT
ABS2

/* set number of peaks to fit */

STORET1PAR( "NUMPNTS", lastpoint )

/* now perform a T1 or T2 calculation */

if (t1_t2_mode == 1)
{
  STORET1PAR( "NUMTERM", 3 )
  PD
  DAT1
}
if (t1_t2_mode == 2)
{
  STORET1PAR( "NUMTERM", 2 )
  PD
  DAT2
}

sprintf(text, "T%d result stored in %s", t1_t2_mode, PROCPATH("ct1t2.txt"));
Show_status(text);
QUITMSG(text)
